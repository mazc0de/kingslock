# Supabase project → Project Settings → API Keys.
# Use the PUBLISHABLE key (starts with "sb_publishable_") — or the legacy
# "anon" key on older projects. Both are safe to ship to the browser.
# NEVER put the secret key ("sb_secret_...") or service_role key here.
VITE_SUPABASE_URL=https://<PROJECT_REF>.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx
